# Add these server-only settings to .env.local and to your deployment environment.
# Create a dedicated Bunny Stream library; see README.md, "Bunny Stream recordings".
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=
# The Stream library's READ-ONLY API key, used to verify webhook signatures.
BUNNY_STREAM_WEBHOOK_SECRET=
